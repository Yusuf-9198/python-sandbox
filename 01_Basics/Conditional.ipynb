   "source": [
    "marks = int(input(\"Enter Marks : \"))\n",
    "# marks = 81\n",
    "if marks >= 90:\n",
    "    print(\"Grade A+\")\n",
    "elif 90 >= marks > 60:\n",
    "    print(\"Grade A\")\n",
    "elif 40 <= marks < 60:\n",
    "    print(\"grade B\")\n",
    "else :\n",
    "    print(\"Failed\")\n",
    "print(\"Terminated\")"
   ],
